{
  "name": "protstock-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "test:sector": "node --experimental-strip-types --test tests/sector-history.test.mjs",
    "test:watchlist": "node --experimental-strip-types --test tests/watchlist.test.mjs tests/watchlist-sync.test.mjs",
    "test:signals": "node --experimental-strip-types --test tests/signal-triage.test.mjs",
    "test:runtime": "node --experimental-strip-types --test tests/v4-runtime.test.mjs tests/release-labels.test.mjs",
    "test:portfolio": "node --experimental-strip-types --test tests/portfolio-ledger.test.mjs",
    "test:journal": "node --experimental-strip-types --test tests/journal-evidence.test.mjs tests/journal-outbox.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.43.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
